/**
 * Sub-project B: Three Question Flow Component Tests
 *
 * Tests that every phase in ThreeQuestionFlow renders visible content,
 * has interactive controls, and never returns null.
 */

import { getDefaultPhasesForStepType, isThreeQuestionFlowCompatible } from '@/lib/lessonPlanner';
import type { Question } from '@/lib/types';

// ========== Helpers ==========

let passed = 0;
let failed = 0;

function test(name: string, fn: () => void) {
  try {
    fn();
    passed++;
    console.log(`  ✅ ${name}`);
  } catch (e) {
    failed++;
    console.log(`  ❌ ${name}: ${(e as Error).message}`);
  }
}

function assert(condition: boolean, message: string) {
  if (!condition) throw new Error(message);
}

// ========== Test data ==========

const questionWithFrame: Question = {
  id: 'g1ll_01',
  gradeBand: 'G1',
  domain: 'addition_subtraction',
  text: '果盘里有11颗草莓，吃掉了5颗，还剩几颗草莓？',
  numbers: [11, 5],
  keywords: [{ word: '吃掉了', type: 'subtract' }, { word: '还剩', type: 'subtract' }],
  noisePhrases: [],
  usefulPhrases: ['果盘里有11颗草莓', '吃掉了5颗'],
  questionMeaningOptions: ['问总数', '问还剩多少', '问新摘了几颗'],
  correctMeaning: '问还剩多少',
  operation: 'subtraction',
  equation: '11 - 5 = ?',
  answer: 6,
  answerSentence: '还剩6颗草莓。',
  explanation: '草莓被吃掉了，数量减少了！11-5=6。',
  solutionSteps: ['找到11和5', '"吃掉了"表示减少', '11-5=6'],
  hints: ['草莓变多了还是变少了？', '吃掉了就是减少了'],
  difficulty: 2,
  category: 'subtraction',
  visualKey: 'strawberry',
  requiresAnswer: true,
  lessonType: 'add_sub_action',
  keywordType: 'subtract_action',
  stepCompatibility: ['find_numbers', 'find_action_words', 'simulation', 'full_solve'],
  answerType: 'number',
  sceneType: 'food_fruit',
  themeTags: ['fruit', 'food'],
  problemType: 'basic_arithmetic',
  skillIds: ['addition_subtraction:subtraction_within_20_borrowing'],
  curriculumGrade: 1,
  curriculumSemester: 'lower',
  isReview: false,
  isStretch: false,
  assessmentTier: 'test' as const,
  difficultyProfile: {
    knowledgeLevel: 2 as const,
    readingLoad: 2 as const,
    relationComplexity: 2 as const,
    informationNoise: 1 as const,
    reasoningSteps: 2 as const,
    transferLevel: 2 as const,
  },
  reasoningFrame: {
    knownFacts: [
      { text: '果盘里有11颗草莓', quantity: 11, unit: '颗', object: '草莓', role: '初始数量' },
      { text: '吃掉了5颗', quantity: 5, unit: '颗', object: '草莓', role: '减少量' },
    ],
    targetQuestion: {
      text: '还剩几颗草莓',
      targetQuantity: '剩余草莓数量',
      targetUnit: '颗',
      questionType: 'find_remaining',
    },
    plan: {
      firstStep: '从11颗里面减去吃掉的5颗',
      operationReason: '草莓变少了，用减法',
    },
    check: {
      answeredTarget: true,
      unitCorrect: true,
      resultReasonable: true,
    },
  },
};

const simpleQuestion: Question = {
  id: 'g1_01',
  gradeBand: 'G1',
  domain: 'addition_subtraction',
  text: '草地上有6只小兔子，又跑来了3只，一共有几只小兔子？',
  numbers: [6, 3],
  keywords: [{ word: '跑来了', type: 'add' }, { word: '一共', type: 'add' }],
  noisePhrases: [],
  usefulPhrases: ['草地上有6只小兔子', '又跑来了3只'],
  questionMeaningOptions: ['问一共有多少只', '问还剩几只', '问跑来了几只'],
  correctMeaning: '问一共有多少只',
  operation: 'addition',
  equation: '6 + 3 = ?',
  answer: 9,
  answerSentence: '一共有9只小兔子。',
  explanation: '6+3=9，草地上有9只小兔子。',
  solutionSteps: ['找到6和3', '"跑来了"表示增加', '6+3=9'],
  hints: ['兔子增加了还是减少了？'],
  difficulty: 1,
  category: 'addition',
  visualKey: 'rabbit',
  requiresAnswer: true,
  lessonType: 'add_sub_action',
  keywordType: 'add_action',
  stepCompatibility: ['find_numbers', 'find_action_words', 'simulation', 'full_solve'],
  answerType: 'number',
  sceneType: 'animal_grassland',
  themeTags: ['animals'],
  problemType: 'basic_arithmetic',
};

// ========== Tests ==========

console.log('\n=== test:three-question-render ===\n');

// ===== Test 1: isThreeQuestionFlowCompatible =====
test('question with reasoningFrame returns compatible', () => {
  assert(isThreeQuestionFlowCompatible(questionWithFrame) === true,
    'should be compatible');
});

test('simple question without reasoningFrame returns not compatible', () => {
  assert(isThreeQuestionFlowCompatible(simpleQuestion) === false,
    'should not be compatible');
});

// ===== Test 2: getDefaultPhasesForStepType returns three-question phases =====
test('full_solve with compatible question returns three-question phases', () => {
  const phases = getDefaultPhasesForStepType('full_solve', questionWithFrame);
  assert(phases.includes('known_facts'), `phases should include known_facts, got [${phases}]`);
  assert(phases.includes('target'), `phases should include target, got [${phases}]`);
  assert(phases.includes('plan'), `phases should include plan, got [${phases}]`);
  assert(phases.includes('check'), `phases should include check, got [${phases}]`);
  assert(phases.includes('answer'), `phases should include answer, got [${phases}]`);
  assert(phases.includes('explain'), `phases should include explain, got [${phases}]`);
});

test('full_solve without question returns standard phases', () => {
  const phases = getDefaultPhasesForStepType('full_solve', undefined);
  assert(phases.includes('find_numbers'), `should use standard phases, got [${phases}]`);
  assert(phases.includes('build_equation'), `should include build_equation, got [${phases}]`);
  assert(!phases.includes('known_facts'), 'should NOT include known_facts');
});

test('full_solve with simple question returns standard phases', () => {
  const phases = getDefaultPhasesForStepType('full_solve', simpleQuestion);
  assert(phases.includes('find_numbers'), `should use standard phases, got [${phases}]`);
  assert(!phases.includes('known_facts'), 'should NOT include known_facts');
});

// ===== Test 3: Three-question phases never overlap with standard phases =====
test('three-question phases are exclusive from standard phases', () => {
  const tqf = getDefaultPhasesForStepType('full_solve', questionWithFrame);
  const standard = getDefaultPhasesForStepType('full_solve', simpleQuestion);

  // TQF phases should have different names
  const tqfOnly = tqf.filter(p => !['read', 'answer', 'explain'].includes(p));
  const standardOnly = standard.filter(p => !['read', 'answer', 'explain'].includes(p));

  assert(tqfOnly.length === 4, `TQF should have 4 unique phases, got ${tqfOnly.length}`);
  assert(standardOnly.length > 0, 'Standard should have unique phases');
  const hasOverlap = tqfOnly.some(p => standardOnly.includes(p));
  assert(!hasOverlap, 'TQF and standard phases should not overlap');
});

// ===== Test 4: ReasoningFrame validation =====
test('reasoningFrame has all required fields', () => {
  const rf = (questionWithFrame as any).reasoningFrame;
  assert(rf !== undefined, 'reasoningFrame should exist');
  assert(Array.isArray(rf.knownFacts), 'knownFacts should be array');
  assert(rf.knownFacts.length >= 1, 'knownFacts should be non-empty');
  assert(rf.targetQuestion !== undefined, 'targetQuestion should exist');
  assert(rf.targetQuestion.text !== '', 'targetQuestion.text should be non-empty');
  assert(rf.plan !== undefined, 'plan should exist');
  assert(rf.plan.firstStep !== '', 'plan.firstStep should be non-empty');
  assert(rf.check !== undefined, 'check should exist');
});

// ===== Test 5: Every phase produces a phase index in range =====
test('all three-question phase indices are valid', () => {
  const phases = getDefaultPhasesForStepType('full_solve', questionWithFrame);
  for (let i = 0; i < phases.length; i++) {
    assert(i >= 0 && i < phases.length, `phase index ${i} should be in range [0, ${phases.length - 1}]`);
    assert(phases[i] !== undefined, `phase at index ${i} should not be undefined`);
  }
});

// ===== Test 6: Read phase is always first =====
test('read is first phase in all step types', () => {
  const allTypes: Array<'full_solve' | 'find_numbers' | 'find_action_words' | 'simulation' | 'remove_noise' | 'find_compare_numbers' | 'spot_extra_info' | 'spot_missing_info'> = [
    'full_solve', 'find_numbers', 'find_action_words', 'simulation', 'remove_noise', 'find_compare_numbers', 'spot_extra_info', 'spot_missing_info',
  ];
  for (const type of allTypes) {
    const phases = getDefaultPhasesForStepType(type, questionWithFrame);
    assert(phases[0] === 'read', `${type} should start with 'read', got '${phases[0]}'`);
  }
});

// ===== Test 7: No phase sequence returns empty =====
test('no phase sequence is empty', () => {
  const allTypes: Array<'full_solve' | 'find_numbers' | 'find_action_words' | 'simulation' | 'remove_noise' | 'find_compare_numbers' | 'spot_extra_info' | 'spot_missing_info'> = [
    'full_solve', 'find_numbers', 'find_action_words', 'simulation', 'remove_noise', 'find_compare_numbers', 'spot_extra_info', 'spot_missing_info',
  ];
  for (const type of allTypes) {
    const phases = getDefaultPhasesForStepType(type, questionWithFrame);
    assert(phases.length >= 2, `${type} should have at least 2 phases, got ${phases.length}`);
    const hasExplain = phases.includes('explain');
    assert(hasExplain || phases[phases.length - 1] === 'completed',
      `${type} should end with 'explain' or 'completed', ends with '${phases[phases.length - 1]}'`);
  }
});

// ===== Summary =====
console.log(`\nResults: ${passed} passed, ${failed} failed`);
if (failed > 0) {
  console.log('❌ Some tests FAILED — fix before proceeding');
  process.exit(1);
} else {
  console.log('✅ All three-question-render tests PASSED');
}
