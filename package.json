{
  "name": "math-detective",
  "version": "2.15.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/postbuild-css.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:questions": "tsx -r tsconfig-paths/register scripts/validate-questions.ts",
    "validate:themes": "node scripts/validate-themes.mjs",
    "validate:hints": "node scripts/validate-hints.mjs",
    "validate:lesson-generation": "node scripts/validate-lesson-generation.mjs",
    "validate:child-ui": "node scripts/validate-child-ui.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:numeric-skill-labels": "tsx -r tsconfig-paths/register scripts/validate-numeric-skill-labels.ts",
    "validate:semantic-skills": "tsx -r tsconfig-paths/register scripts/validate-semantic-skills.ts",
    "validate:reasoning-frame": "tsx -r tsconfig-paths/register scripts/validate-reasoning-frame.ts",
    "validate:v291": "npm run validate:numeric-skill-labels && npm run validate:semantic-skills && npm run validate:reasoning-frame",
    "test:submit-transaction": "tsx -r tsconfig-paths/register tests/unit/submit-transaction.test.ts",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:state-machine": "tsx -r tsconfig-paths/register tests/unit/lesson-state-machine.test.ts",
    "test:three-question-render": "tsx -r tsconfig-paths/register tests/component/three-question-flow.test.ts",
    "test:scoring": "tsx -r tsconfig-paths/register tests/unit/scoring.test.ts",
    "test:data-export": "tsx -r tsconfig-paths/register tests/unit/data-export.test.ts",
    "test:curriculum": "tsx -r tsconfig-paths/register __tests__/v290/test-curriculum.ts",
    "test:adaptive-difficulty": "tsx -r tsconfig-paths/register __tests__/v290/test-adaptive-difficulty.ts",
    "test:question-distribution": "tsx -r tsconfig-paths/register __tests__/v290/test-question-distribution.ts",
    "test:real-curriculum-generation": "tsx -r tsconfig-paths/register tests/integration/real-curriculum-generation.test.ts",
    "test:v290": "npm run test:curriculum && npm run test:adaptive-difficulty && npm run test:question-distribution && npm run test:real-lesson-generation",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:play": "node scripts/run-playwright.js tests/e2e/play-no-home-redirect.spec.ts",
    "test:e2e:reward": "node scripts/run-playwright.js tests/e2e/reward-once.spec.ts",
    "test:e2e:repair": "node scripts/run-playwright.js tests/e2e/repair-loop.spec.ts",
    "test:e2e:no-irrelevant": "node scripts/run-playwright.js tests/e2e/no-irrelevant-number-step.spec.ts",
    "validate:extra-info": "node scripts/audit-extra-info.mjs",
    "test:e2e:pattern": "node scripts/run-playwright.js tests/e2e/pattern-step-loop.spec.ts",
    "test:e2e:playthrough": "node scripts/run-playwright.js tests/e2e/full-lesson-playthrough.spec.ts",
    "test:parent-password": "tsx tests/unit/parent-password.test.ts",
    "test:direct-meaning": "tsx -r tsconfig-paths/register tests/unit/direct-meaning-validation.test.ts",
    "test:completion-reward": "tsx -r tsconfig-paths/register tests/unit/completion-reward-transaction.test.ts",
    "test:independent-content": "tsx -r tsconfig-paths/register tests/unit/independent-solving-content.test.ts",
    "test:independent-runtime": "tsx -r tsconfig-paths/register tests/unit/independent-solving-runtime.test.ts",
    "test:solving-metrics": "tsx -r tsconfig-paths/register tests/unit/solving-metrics.test.ts",
    "test:mistake-explanation": "tsx -r tsconfig-paths/register tests/unit/mistake-explanation-gate.test.ts",
    "audit:independent-solving": "tsx -r tsconfig-paths/register scripts/audit-independent-solving.ts",
    "test:transfer-sources": "tsx -r tsconfig-paths/register tests/unit/transfer-source-corrections.test.ts",
    "test:transfer-registry": "tsx -r tsconfig-paths/register tests/unit/transfer-registry.test.ts",
    "test:transfer-oracle": "tsx -r tsconfig-paths/register tests/unit/transfer-expansion-oracle.test.ts",
    "audit:transfer-expansion": "tsx -r tsconfig-paths/register scripts/audit-transfer-expansion.ts"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.12.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "process": "^0.11.10",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
