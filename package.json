{
  "name": "math-detective",
  "version": "2.8.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/postbuild-css.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:questions": "tsx -r tsconfig-paths/register scripts/validate-questions.ts",
    "validate:themes": "node scripts/validate-themes.mjs",
    "validate:hints": "node scripts/validate-hints.mjs",
    "validate:lesson-generation": "node scripts/validate-lesson-generation.mjs",
    "validate:child-ui": "node scripts/validate-child-ui.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test:state-machine": "tsx -r tsconfig-paths/register tests/unit/lesson-state-machine.test.ts",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:play": "node scripts/run-playwright.js tests/e2e/play-no-home-redirect.spec.ts",
    "test:e2e:reward": "node scripts/run-playwright.js tests/e2e/reward-once.spec.ts",
    "test:e2e:repair": "node scripts/run-playwright.js tests/e2e/repair-loop.spec.ts",
    "test:e2e:no-irrelevant": "node scripts/run-playwright.js tests/e2e/no-irrelevant-number-step.spec.ts",
    "validate:extra-info": "node scripts/audit-extra-info.mjs",
    "test:e2e:pattern": "node scripts/run-playwright.js tests/e2e/pattern-step-loop.spec.ts",
    "test:e2e:playthrough": "node scripts/run-playwright.js tests/e2e/full-lesson-playthrough.spec.ts"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.12.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
